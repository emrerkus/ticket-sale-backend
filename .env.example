# Bu dosya sablondur ve git'e commit'lenir. Gercek degerler icin kopyala:
#   cp .env.example .env
# .env dosyasi .gitignore'da -> sirlar repoya girmez.

# --- HTTP sunucu ---
HTTP_PORT=8080
APP_ENV=development

# Sunucuya kapan sinyali (Ctrl+C) geldiginde acik istekleri bitirmek icin taninan sure.
SHUTDOWN_TIMEOUT=10s

# --- PostgreSQL ---
# docker-compose.yml'daki postgres servisiyle eslesir. Host portu 5433 (5432 degil).
DATABASE_URL=postgres://ticketsale:ticketsale_dev_pw@localhost:5433/ticketsale?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379

# --- Kimlik dogrulama ---
# Uretimde uzun, rastgele bir deger olmali. Bu anahtari bilen gecerli token uretebilir.
JWT_SECRET=dev-only-super-secret-change-in-prod
JWT_TTL=24h

# --- Frontend (CORS) ---
CORS_ORIGIN=http://localhost:5173
